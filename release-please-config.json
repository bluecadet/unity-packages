{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "tag-separator": "@",
  "separate-pull-requests": false,
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Fixed" },
    { "type": "refactor", "section": "Changed" },
    { "type": "test", "section": "Other", "hidden": true },
    { "type": "chore", "section": "Other", "hidden": true },
    { "type": "docs", "section": "Other", "hidden": true },
    { "type": "ci", "section": "Other", "hidden": true },
    { "type": "style", "section": "Other", "hidden": true }
  ],
  "packages": {
    "Packages/com.bluecadet.hap": {
      "component": "com.bluecadet.hap"
    },
    "Packages/com.bluecadet.spring": {
      "component": "com.bluecadet.spring"
    },
    "Packages/com.bluecadet.touchscreen": {
      "component": "com.bluecadet.touchscreen"
    },
    "Packages/com.bluecadet.uiblur": {
      "component": "com.bluecadet.uiblur"
    },
    "Packages/com.bluecadet.uiblur-hdrp": {
      "component": "com.bluecadet.uiblur-hdrp"
    },
    "Packages/com.bluecadet.utils": {
      "component": "com.bluecadet.utils"
    }
  }
}
